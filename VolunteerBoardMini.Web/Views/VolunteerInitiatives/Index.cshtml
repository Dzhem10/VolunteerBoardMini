
@model IEnumerable<VolunteerBoardMini.Data.DTOs.VolunteerInitiativeDto>

@{
    ViewData["Title"] = "Доброволчески инициативи";
}

<h1>Доброволчески инициативи</h1>

<a asp-action="Create" class="btn btn-success mb-3">
    Добави инициатива
</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Име</th>
            <th>Организатор</th>
            <th>Местоположение</th>
            <th>Необходими доброволци</th>
            <th>Описание</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var initiative in Model)
        {
            <tr>
                <td>@initiative.Name</td>
                <td>@initiative.Organizer</td>
                <td>@initiative.Location</td>
                <td>@initiative.RequiredVolunteers</td>
                <td>@initiative.Description</td>
            </tr>
        }
    </tbody>
</table>
